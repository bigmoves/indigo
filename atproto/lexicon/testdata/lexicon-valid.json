[
  {
    "name": "minimal",
    "lexicon": {
      "lexicon": 1,
      "id": "example.lexicon.other",
      "defs": {
        "demo": {
          "type": "integer"
        }
      }
    }
  },
  {
    "name": "minimal record",
    "lexicon": {
      "lexicon": 1,
      "id": "example.lexicon.record",
      "defs": {
        "main": {
          "type": "record",
          "key": "any",
          "record": {
            "type": "object",
            "properties": {}
          }
        }
      }
    }
  },
  {
    "name": "basic permission-set",
    "lexicon": {
      "lexicon": 1,
      "id": "example.lexicon.perms",
      "defs": {
        "main": {
          "type": "permission-set",
          "title": "test case",
          "permissions": [
            {
              "type": "permission",
              "resource": "repo",
              "collection": [
                "com.example.calendar.event"
              ],
              "action": [
                "delete",
                "create"
              ]
            },
            {
              "type": "permission",
              "resource": "repo",
              "collection": [
                "com.example.calendar.rsvp"
              ]
            },
            {
              "type": "permission",
              "resource": "rpc",
              "lxm": ["example.lexicon.endpoint"],
              "aud": "*"
            },
            {
              "type": "permission",
              "resource": "rpc",
              "lxm": ["example.lexicon.endpointTwo"],
              "inheritAud": true
            },
            {
              "type": "permission",
              "resource": "space",
              "spaceType": "example.lexicon.group",
              "collection": ["com.example.calendar.event"],
              "action": ["read", "create"]
            },
            {
              "type": "permission",
              "resource": "space",
              "spaceType": "example.lexicon.group",
              "authority": "*",
              "skey": "general",
              "collection": ["*"],
              "action": ["read_self"],
              "manage": ["create", "update", "delete"]
            }
          ]
        }
      }
    }
  },
  {
    "name": "basic space",
    "lexicon": {
      "lexicon": 1,
      "id": "com.atmoboards.forum",
      "defs": {
        "main": {
          "type": "space",
          "key": "any",
          "title": "AtmoBoards Forum",
          "description": "A discussion forum",
          "title:lang": {
            "es": "Foro AtmoBoards",
            "ja": "AtmoBoards 掲示板"
          },
          "collections": ["com.atmoboards.thread", "com.atmoboards.reply"]
        }
      }
    }
  },
  {
    "name": "space with empty collections",
    "lexicon": {
      "lexicon": 1,
      "id": "com.example.empty",
      "defs": {
        "main": {
          "type": "space",
          "key": "tid",
          "title": "Empty Space",
          "collections": []
        }
      }
    }
  },
  {
    "name": "space without title",
    "lexicon": {
      "lexicon": 1,
      "id": "com.example.untitled",
      "defs": {
        "main": {
          "type": "space",
          "key": "any",
          "collections": ["com.example.post"]
        }
      }
    }
  }
]
